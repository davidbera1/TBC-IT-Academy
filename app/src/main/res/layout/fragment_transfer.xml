<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.screens.transfer.TransferFragment">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTransferInternally"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/transfer_internally"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTransferInternally" />


    <!-- FROM -->
    <View
        android:id="@+id/fromContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rounded_corners"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/tvTransferInternally" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFrom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="5dp"
        android:text="@string/from"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/fromContainer"
        app:layout_constraintStart_toStartOf="@id/fromContainer" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgFromCard"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/circle"
        android:backgroundTint="@color/white"
        android:padding="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/fromContainer"
        app:layout_constraintStart_toStartOf="@id/fromContainer"
        app:layout_constraintTop_toTopOf="@+id/fromContainer"
        app:srcCompat="@drawable/visa" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFromCardName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="5dp"
        android:text="@string/cash"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/tvFromAmount"
        app:layout_constraintStart_toEndOf="@id/imgFromCard"
        app:layout_constraintTop_toTopOf="@id/imgFromCard" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFromAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/_350"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/imgFromCard"
        app:layout_constraintStart_toEndOf="@id/imgFromCard"
        app:layout_constraintTop_toBottomOf="@id/tvFromCardName" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFromCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="@string/GEL"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/tvFromAmount"
        app:layout_constraintStart_toEndOf="@id/tvFromAmount"
        app:layout_constraintTop_toTopOf="@id/tvFromAmount" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFromCardNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="@string/_2345"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/fromContainer"
        app:layout_constraintEnd_toEndOf="@id/fromContainer"
        app:layout_constraintTop_toTopOf="@id/fromContainer" />


    <!-- TO -->
    <View
        android:id="@+id/toContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rounded_corners"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/fromContainer" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="5dp"
        android:text="@string/to"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/toContainer"
        app:layout_constraintStart_toStartOf="@id/toContainer" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgToCard"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/circle"
        android:backgroundTint="@color/white"
        android:padding="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/toContainer"
        app:layout_constraintStart_toStartOf="@id/toContainer"
        app:layout_constraintTop_toTopOf="@+id/toContainer"
        app:srcCompat="@drawable/visa" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToCardName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="5dp"
        android:text="@string/cash"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/tvToAmount"
        app:layout_constraintStart_toEndOf="@id/imgToCard"
        app:layout_constraintTop_toTopOf="@id/imgToCard" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/_10"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/imgToCard"
        app:layout_constraintStart_toEndOf="@id/imgToCard"
        app:layout_constraintTop_toBottomOf="@id/tvToCardName" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="@string/EUR"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@id/tvToAmount"
        app:layout_constraintStart_toEndOf="@id/tvToAmount"
        app:layout_constraintTop_toTopOf="@id/tvToAmount" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvToCardNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:text="@string/_2345"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/toContainer"
        app:layout_constraintEnd_toEndOf="@id/toContainer"
        app:layout_constraintTop_toTopOf="@id/toContainer" />


    <!--  Sell  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sellContainer"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rounded_corners"
        android:backgroundTint="@color/background_light"
        android:backgroundTintMode="src_over"
        app:layout_constraintEnd_toStartOf="@id/buyContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toContainer">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:text="@string/sell"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etSell"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="5dp"
            android:background="@android:color/transparent"
            android:hint="@string/amount"
            android:inputType="numberDecimal"
            android:maxLength="7"
            android:textColor="@color/white"
            android:textColorHint="@android:color/darker_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSell" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSellCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/GEL"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/etSell"
            app:layout_constraintStart_toEndOf="@id/etSell"
            app:layout_constraintTop_toTopOf="@id/etSell" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!--  Buy  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buyContainer"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rounded_corners"
        android:backgroundTint="@color/background_light"
        android:backgroundTintMode="src_over"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sellContainer"
        app:layout_constraintTop_toBottomOf="@id/toContainer">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBuy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:text="@string/buy"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etBuy"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="5dp"
            android:background="@android:color/transparent"
            android:hint="@string/amount"
            android:inputType="numberDecimal"
            android:maxLength="7"
            android:textColor="@color/white"
            android:textColorHint="@android:color/darker_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuy" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvBuyCurrency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/EUR"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/etBuy"
            app:layout_constraintStart_toEndOf="@id/etBuy"
            app:layout_constraintTop_toTopOf="@id/etBuy" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCurrencyInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/_1_0_33"
        android:textColor="@android:color/darker_gray"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sellContainer" />


    <!--  Description  -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/descriptionContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rounded_corners"
        android:backgroundTint="@color/background_light"
        android:backgroundTintMode="src_over"
        app:layout_constraintTop_toBottomOf="@id/tvCurrencyInfo">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:text="@string/description"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@android:color/transparent"
            android:hint="@string/write_description"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/white"
            android:textColorHint="@android:color/darker_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="50dp"
        android:background="@drawable/btn_background"
        android:text="@string/_continue"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
