<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="202dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="182dp"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/order_item_background"
        android:elevation="2dp" >


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="25dp"
            android:layout_marginTop="18dp"
            android:text="@string/order"
            android:textStyle="bold"
            android:textSize="18sp"
            android:fontFamily="@font/product_sans"
            android:textColor="@color/black"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTracking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOrderId"
            android:layout_marginStart="25dp"
            android:layout_marginTop="24dp"
            android:textColor="@color/neutral"
            android:textSize="14sp"
            android:fontFamily="@font/product_sans"
            android:text="@string/tracking_number"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTrackingNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/tvTracking"
            app:layout_constraintTop_toBottomOf="@id/tvOrderId"
            android:layout_marginStart="10dp"
            android:layout_marginTop="24dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:fontFamily="@font/product_sans"/>
        
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvQuantity1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTracking"
            android:layout_marginTop="24dp"
            android:layout_marginStart="25dp"
            android:text="@string/quantity"
            android:textSize="14sp"
            android:fontFamily="@font/product_sans"
            android:textColor="@color/neutral"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/tvQuantity1"
            app:layout_constraintTop_toBottomOf="@id/tvTracking"
            android:layout_marginTop="24dp"
            android:layout_marginStart="10dp"
            android:textSize="14sp"
            android:fontFamily="@font/product_sans"
            android:textColor="@color/black"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuantity"
            android:layout_marginTop="31dp"
            android:layout_marginStart="25dp"
            android:text="@string/pending"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:fontFamily="@font/product_sans"
            android:textColor="@color/pending"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/product_sans"
            android:textColor="@color/neutral"
            android:textSize="14sp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSubtotal1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTracking"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="53dp"
            android:textColor="@color/neutral"
            android:fontFamily="@font/product_sans"
            android:text="@string/subtotal"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/tvSubtotal1"
            app:layout_constraintTop_toBottomOf="@id/tvTracking"
            android:layout_marginTop="22dp"
            android:layout_marginStart="4dp"
            android:textColor="@color/black"
            android:fontFamily="@font/product_sans"/>

        
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDetails"
            android:layout_width="100dp"
            android:layout_height="35dp"
            android:background="@drawable/button_background"
            app:layout_constraintTop_toBottomOf="@id/tvSubtotal1"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="19dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/product_sans"
            android:textAllCaps="false"
            android:text="@string/details"
            android:textColor="@color/black"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>