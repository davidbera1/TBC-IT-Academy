<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".EditAddressFragment">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvEditAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        android:textColor="@color/black"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="@font/product_sans"
        android:text="@string/edit_address"/>


    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etAddressName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/tvEditAddress"
        android:layout_marginTop="100dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:hint="@string/enter_new_place_name"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etAddress"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/etAddressName"
        android:layout_marginTop="10dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:hint="@string/enter_new_address"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvChooseIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etAddress"
        android:layout_marginTop="50dp"
        android:text="@string/update_icon"
        android:textColor="@color/black"
        android:textSize="18sp"/>

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cbHome"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvChooseIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.3"
        android:layout_marginTop="30dp"
        android:button="@null"
        android:drawableStart="@drawable/custom_checkbox"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/home"
        app:layout_constraintStart_toEndOf="@id/cbHome"
        app:layout_constraintTop_toBottomOf="@id/tvChooseIcon"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"/>

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cbOffice"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvChooseIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.6"
        android:layout_marginTop="30dp"
        android:button="@null"
        android:drawableStart="@drawable/custom_checkbox"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgOffice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/office"
        app:layout_constraintStart_toEndOf="@id/cbOffice"
        app:layout_constraintTop_toBottomOf="@id/tvChooseIcon"
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEditAddress"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/button_black_rounded_corners"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cbOffice"
        android:layout_marginTop="100dp"
        android:textColor="@color/white"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/save_changes"/>

</androidx.constraintlayout.widget.ConstraintLayout>