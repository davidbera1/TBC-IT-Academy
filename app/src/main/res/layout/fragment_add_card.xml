<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.AddCardFragment">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_circle"
        android:elevation="2dp"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAddNewCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/poppins"
        android:text="@string/add_new_card"
        android:textColor="@color/light_black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgCard"
        android:layout_width="match_parent"
        android:layout_height="191dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvAddNewCard"
        app:srcCompat="@drawable/mastercard" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCardHolderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="49dp"
        android:fontFamily="@font/poppins"
        android:text="@string/cardholder_name"
        android:textColor="@color/gray"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgCard" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etCardHolderName"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/et_background"
        android:fontFamily="@font/poppins"
        android:hint="@string/enter_your_name_here"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/input_text_color"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvCardHolderName" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCardNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="29dp"
        android:fontFamily="@font/poppins"
        android:text="@string/card_number"
        android:textColor="@color/gray"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etCardHolderName" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etCardNumber"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/et_background"
        android:fontFamily="@font/poppins"
        android:hint="@string/enter_card_number"
        android:inputType="number"
        android:maxLength="16"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/input_text_color"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvCardNumber" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvExpires"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="29dp"
        android:fontFamily="@font/poppins"
        android:text="@string/expires"
        android:textColor="@color/gray"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etCardNumber" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etExpires"
        android:layout_width="142dp"
        android:layout_height="42dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/et_background"
        android:fontFamily="@font/poppins"
        android:hint="@string/mm_yy"
        android:maxLength="5"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/input_text_color"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvExpires" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCVV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="31dp"
        android:layout_marginTop="29dp"
        android:fontFamily="@font/poppins"
        android:text="@string/cvv"
        android:textColor="@color/gray"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/etExpires"
        app:layout_constraintTop_toBottomOf="@+id/etCardNumber" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etCVV"
        android:layout_width="142dp"
        android:layout_height="42dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/et_background"
        android:fontFamily="@font/poppins"
        android:hint="@string/cvv"
        android:inputType="number"
        android:maxLength="3"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/input_text_color"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tvCVV"
        app:layout_constraintTop_toBottomOf="@id/tvExpires" />

    <androidx.appcompat.widget.AppCompatRadioButton
        android:id="@+id/rbMastercard"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:checked="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etExpires" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMastercard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:fontFamily="@font/poppins"
        android:text="@string/mastercard"
        app:layout_constraintStart_toEndOf="@id/rbMastercard"
        app:layout_constraintTop_toBottomOf="@id/etExpires" />

    <androidx.appcompat.widget.AppCompatRadioButton
        android:id="@+id/rbVisa"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toEndOf="@id/tvMastercard"
        app:layout_constraintTop_toBottomOf="@id/etExpires" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvVisa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:fontFamily="@font/poppins"
        android:text="@string/visa"
        app:layout_constraintStart_toEndOf="@id/rbVisa"
        app:layout_constraintTop_toBottomOf="@id/etExpires" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddCard"
        android:layout_width="203dp"
        android:layout_height="48dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/button_rounded_corners"
        android:fontFamily="@font/product_sans"
        android:text="@string/add_card"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMastercard" />


</androidx.constraintlayout.widget.ConstraintLayout>