<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".LoginFragment">

    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:clickable="true"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"/>

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.15"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvLoginToYourAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        android:textColor="@color/black"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        android:text="@string/login_to_your_account"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etEmail"
        android:background="@drawable/edittext_corners_rounded"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/tvLoginToYourAccount"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:hint="@string/email"
        android:paddingStart="50dp"
        android:paddingEnd="10dp"/>

    <ImageView
        android:id="@+id/imgEmail"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/email"
        app:layout_constraintStart_toStartOf="@id/etEmail"
        app:layout_constraintTop_toTopOf="@id/etEmail"
        app:layout_constraintBottom_toBottomOf="@id/etEmail"
        android:layout_marginStart="10dp"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etPassword"
        android:background="@drawable/edittext_corners_rounded"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/etEmail"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"/>

    <ImageView
        android:id="@+id/imgPassword"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/password"
        app:layout_constraintStart_toStartOf="@id/etPassword"
        app:layout_constraintTop_toTopOf="@id/etPassword"
        app:layout_constraintBottom_toBottomOf="@id/etPassword"
        android:layout_marginStart="10dp"/>

    <ImageView
        android:id="@+id/imgShowPassword"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/eye_off"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="@id/etPassword"
        app:layout_constraintEnd_toEndOf="@id/etPassword"
        app:layout_constraintBottom_toBottomOf="@id/etPassword"
        android:layout_marginEnd="10dp"/>

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cbRemember"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        android:layout_marginTop="10dp"
        app:layout_constraintHorizontal_bias="0.35"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvRememberMe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/cbRemember"
        app:layout_constraintTop_toBottomOf="@id/etPassword"
        android:layout_marginTop="15dp"
        android:textColor="@color/black"
        android:text="@string/remember_me"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSignIn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/black_button"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/cbRemember"
        android:textColor="@color/white"
        android:text="@string/sign_in"
        android:textAllCaps="false"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvForgotPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@id/btnSignIn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"
        android:textColor="@color/black"
        android:text="@string/forgot_the_password"/>


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvOrContinueWith"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/btnSignIn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp"
        android:text="@string/or_continue_with"
        android:textColor="@color/gray"
        android:textStyle="bold"
        android:textSize="16sp"/>

    <View
        android:layout_width="90dp"
        android:layout_height="1dp"
        android:background="@color/gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSignIn"
        android:layout_marginTop="82dp"
        android:layout_marginStart="30dp"/>

    <View
        android:layout_width="90dp"
        android:layout_height="1dp"
        android:background="@color/gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSignIn"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="30dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imgBtnFacebook"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:src="@drawable/facebook"
        android:background="@drawable/white_button_outline"
        app:layout_constraintTop_toBottomOf="@id/tvOrContinueWith"
        app:layout_constraintEnd_toStartOf="@id/imgBtnGoogle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imgBtnGoogle"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:src="@drawable/google"
        android:background="@drawable/white_button_outline"
        app:layout_constraintTop_toBottomOf="@id/tvOrContinueWith"
        app:layout_constraintEnd_toStartOf="@id/imgBtnApple"
        app:layout_constraintStart_toEndOf="@+id/imgBtnFacebook"
        android:layout_marginTop="40dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imgBtnApple"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:src="@drawable/apple"
        android:background="@drawable/white_button_outline"
        app:layout_constraintTop_toBottomOf="@id/tvOrContinueWith"
        app:layout_constraintStart_toEndOf="@+id/imgBtnGoogle"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDontHaveAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgBtnGoogle"
        android:layout_marginTop="40dp"
        app:layout_constraintHorizontal_bias="0.4"
        android:textColor="@color/gray"
        android:text="@string/don_t_have_an_account"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        app:layout_constraintStart_toEndOf="@id/tvDontHaveAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgBtnGoogle"
        android:layout_marginTop="40dp"
        app:layout_constraintHorizontal_bias="0.1"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:text="@string/sign_up"/>


</androidx.constraintlayout.widget.ConstraintLayout>