<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.learnandroid.presentation.ui.welcome.WelcomeFragment"
        android:label="fragment_welcome"
        tools:layout="@layout/fragment_welcome" >
        <action
            android:id="@+id/action_welcomeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_bottomNavBarContainerFragment"
            app:destination="@id/bottomNavBarContainerFragment"
            app:popUpTo="@id/nav_graph" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.learnandroid.presentation.ui.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_bottomNavBarContainerFragment"
            app:destination="@id/bottomNavBarContainerFragment"
            app:popUpTo="@id/nav_graph" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.learnandroid.presentation.ui.register.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" />
    <fragment
        android:id="@+id/bottomNavBarContainerFragment"
        android:name="com.example.learnandroid.presentation.ui.bottom_nav_bar_container.BottomNavBarContainerFragment"
        android:label="fragment_bottom_nav_bar_container"
        tools:layout="@layout/fragment_bottom_nav_bar_container" >
        <action
            android:id="@+id/action_bottomNavBarContainerFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/nav_graph" />
        <action
            android:id="@+id/action_bottomNavBarContainerFragment_to_recipeDetailsBottomSheetFragment"
            app:destination="@id/recipeDetailsBottomSheetFragment" />
    </fragment>
    <dialog
        android:id="@+id/recipeDetailsBottomSheetFragment"
        android:name="com.example.learnandroid.presentation.ui.recipe_details_bottom_sheet.RecipeDetailsBottomSheetFragment"
        android:label="fragment_recipe_details_bottom_sheet"
        tools:layout="@layout/fragment_recipe_details_bottom_sheet" >
        <argument
            android:name="recipe"
            app:argType="com.example.learnandroid.presentation.model.Recipe" />
    </dialog>

</navigation>